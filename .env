JIRRABIT_SECRET_KEY=django-insecure--hfi*bj3@3v10yvwos6o+31j*-73!_d573g5ido7vdbqk3_oml
# Comma-separated. This value IS read by settings.py — set it to your own
# domain before exposing the instance, or every request gets a 400.
#
# Two entries exist for the containerised dev stack, where a jirrabit-mcp
# container calls this instance and Django rejects an unlisted Host:
#   - web:              the compose service name, on the shared compose network
#   - host.docker.internal: the same MCP reaching the host-published port
# Add your MCP host's name or IP here too if you put a reverse proxy in front.
JIRRABIT_ALLOWED_HOSTS=localhost,127.0.0.1,web,host.docker.internal
JIRRABIT_DEBUG=1
# Set to 0 when running prod-like locally without a TLS-terminating proxy.
JIRRABIT_SECURE_SSL_REDIRECT=1
JIRRABIT_SECURE_COOKIES=1
JIRRABIT_HSTS_SECONDS=1
JIRRABIT_DB_ENGINE=postgres

# Console backend for local dev — emails print to the web container logs.
# Swap to ``django.core.mail.backends.smtp.EmailBackend`` and fill
# *_HOST/_USER/_PASSWORD when you point at a real SMTP server.
JIRRABIT_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
JIRRABIT_EMAIL_HOST=
JIRRABIT_EMAIL_PORT=587
JIRRABIT_EMAIL_USER=
JIRRABIT_EMAIL_PASSWORD=
JIRRABIT_FROM_EMAIL=jirrabit@localhost


# Postgres
# Postgres. Single connection URI — this is the only variable settings.py reads.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# There are no discrete POSTGRES_* fallbacks for Django: if this is empty or its
# scheme is not postgres://, startup fails loudly rather than guessing.
JIRRABIT_DATABASE_URI=postgres://jirrabit:jirrabit-local-dev@jirrabit-db:5432/jirrabit

# POSTGRES_* below are NOT read by Django. They configure the postgres container
# itself, which uses them to initialise the data directory on first boot. Change
# the password here and in JIRRABIT_DATABASE_URI together — the two must match.
POSTGRES_HOST=jirrabit-db
POSTGRES_DB=jirrabit
POSTGRES_USER=jirrabit
POSTGRES_PASSWORD=jirrabit-local-dev


# Redis
REDIS_URL=redis://redis:6379/0